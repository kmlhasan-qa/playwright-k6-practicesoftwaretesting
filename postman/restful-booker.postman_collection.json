              "raw": "{\n  \"username\": \"nobody\",\n  \"password\": \"wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('error message', () => pm.expect(pm.response.json().error).to.eql('Invalid credentials'));"
                ]
              }
            }
          ]
        }
      ]
