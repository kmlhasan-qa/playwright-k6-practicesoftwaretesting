    {
      "name": "Booking",
      "item": [
        {
          "name": "Create booking - valid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomid\": 2,\n  \"firstname\": \"Postman\",\n  \"lastname\": \"Tester\",\n  \"depositpaid\": false,\n  \"email\": \"qa.postman@example.com\",\n  \"phone\": \"01234567890\",\n  \"bookingdates\": {\n    \"checkin\": \"{{checkin}}\",\n    \"checkout\": \"{{checkout}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// unique far-future stay so the request never collides with other users",
                  "const start = new Date(); start.setDate(start.getDate() + 1000 + Math.floor(Math.random()*2000));",
                  "const end = new Date(start); end.setDate(end.getDate() + 2);",
                  "pm.collectionVariables.set('checkin', start.toISOString().slice(0,10));",
                  "pm.collectionVariables.set('checkout', end.toISOString().slice(0,10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('bookingid returned', () => pm.expect(b.bookingid).to.be.a('number'));",
                  "pm.test('echoes dates', () => pm.expect(b.bookingdates.checkin).to.eql(pm.collectionVariables.get('checkin')));",
                  "pm.collectionVariables.set('bookingId', b.bookingid);"
                ]
              }
            }
          ]
        },
