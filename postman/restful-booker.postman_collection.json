      "name": "Auth",
      "item": [
        {
          "name": "Login - valid admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUser}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().token || (pm.cookies.get('token'));",
                  "pm.test('token returned', () => pm.expect(t).to.be.ok);",
                  "pm.collectionVariables.set('token', t);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - invalid credentials",
          "request": {
            "method": "POST",
            "header": [
              {
